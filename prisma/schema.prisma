generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Project {
  id                  Int                  @id @default(autoincrement())
  name                String
  area                String
  address             String
  type                String
  cost                Int
  deadline            DateTime
  complexity          String
  status              String
  code                String               @unique
  prepayment          Int?
  prepaymentDate      DateTime?
  unitRateId          Int?
  brigadeId           Int?
  clientId            Int?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  communication       String?
  description         String?
  doorType            String?
  floors              Int?
  foundations         String?
  hasMansard          Boolean?
  hasPorhch           Boolean?
  hasVeranda          Boolean?
  insulation          String?
  roofColor           String?
  roofType            String?
  verandaSize         String?
  walls               String?
  windows             String?
  baseType            String?
  homeType            String?
  insulationThickness String?
  layout              String?
  roofMaterial        String?
  completedWorks      CompletedWork[]
  workReports         EmployeeWorkReport[]
  financeReports      FinanceReport[]
  materials           MaterialEstimate[]
  overheads           ProjectOverhead[]
  reports             ProjectReport[]
  transactions        ProjectTransaction[]
  financialPlans      FinancialPlan[]
  client              Client?              @relation(fields: [clientId], references: [id])
  brigade             Brigade?             @relation(fields: [brigadeId], references: [id])
  unitRate            UnitRate?            @relation(fields: [unitRateId], references: [id])
  schedules           Schedule[]
  shopReports         ShopReport[]
  subcontractors      Subcontractor[]      @relation("ProjectToSubcontractor")
  expenses            Expense[]
  movements           WarehouseMovement[]

  @@map("projects")
}

model Client {
  id        Int       @id @default(autoincrement())
  name      String
  phone     String
  email     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]

  @@map("clients")
}

model Brigade {
  id        Int        @id @default(autoincrement())
  name      String
  leaderId  Int
  memberIds String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  employees Employee[]
  projects  Project[]
  schedules Schedule[]
  skills    Skill[]    @relation("BrigadeSkills")

  @@map("brigades")
}

model Employee {
  id             Int                  @id @default(autoincrement())
  fullName       String
  birthDate      DateTime
  phone          String
  address        String
  hireDate       DateTime
  workplace      String
  paymentType    String
  employmentType String
  brigadeId      Int?
  hourlyRateId   Int?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  bonuses        Bonus[]
  workReports    EmployeeWorkReport[]
  brigade        Brigade?             @relation(fields: [brigadeId], references: [id])
  hourlyRate     HourlyRate?          @relation(fields: [hourlyRateId], references: [id])
  penalties      Penalty[]
  schedules      Schedule[]
  shopReports    ShopReport[]
  skills         Skill[]              @relation("EmployeeSkills")

  @@map("employees")
}

// Note: Relations with onDelete: SetNull are defined on the child models below

model WarehouseItem {
  id            Int                 @id @default(autoincrement())
  name          String
  category      String
  quantity      Int
  unit          String
  location      String
  lastUpdate    DateTime
  status        String
  supplierId    Int?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  cost          Int?
  lotNumber     String?
  price         Int?
  notifications Notification[]
  supplier      Supplier?           @relation(fields: [supplierId], references: [id])
  movements     WarehouseMovement[]

  @@map("warehouse_items")
}

model WarehouseMovement {
  id         Int           @id @default(autoincrement())
  itemId     Int
  type       String
  quantity   Int
  amount     Int?
  date       DateTime
  comment    String?
  supplierId Int?
  projectId  Int?
  createdAt  DateTime      @default(now())
  supplier   Supplier?     @relation(fields: [supplierId], references: [id])
  project    Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  item       WarehouseItem @relation(fields: [itemId], references: [id])

  @@index([projectId])
  @@map("warehouse_movements")
}

model UnitRate {
  id            Int       @id @default(autoincrement())
  name          String
  category      String
  unit          String    @default("м²")
  pricePerUnit  Float
  targetType    String    @default("client")
  description   String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  clientPrice   Float?
  employeePrice Float?
  projects      Project[]

  @@map("unit_rates")
}

model MaterialTemplate {
  id        Int      @id @default(autoincrement())
  name      String
  quantity  String
  cost      Int
  category  String?
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("material_templates")
}

model WorkTemplate {
  id              Int              @id @default(autoincrement())
  name            String
  quantity        String
  cost            Int
  category        String?
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  shopReportItems ShopReportItem[]

  @@map("work_templates")
}

model MaterialEstimate {
  id        Int      @id @default(autoincrement())
  projectId Int
  name      String
  quantity  String
  cost      Int
  category  String?
  stage     String?  // Этап сметы
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])

  @@map("material_estimates")
}

model ProjectOverheadTemplate {
  id        Int      @id @default(autoincrement())
  name      String
  cost      Int
  category  String?
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("project_overhead_templates")
}

model ProjectOverhead {
  id        Int      @id @default(autoincrement())
  projectId Int
  name      String
  cost      Int
  category  String?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])

  @@map("project_overheads")
}

model CompletedWork {
  id        Int      @id @default(autoincrement())
  projectId Int
  name      String
  quantity  String
  cost      Int
  category  String?
  stage     String?  // Этап сметы
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])

  @@map("completed_works")
}

model PaymentCategory {
  id         Int      @id @default(autoincrement())
  name       String
  percentage Int
  createdAt  DateTime @default(now())

  @@map("payment_categories")
}

model Fund {
  id           Int               @id @default(autoincrement())
  name         String
  description  String?
  balance      Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  transactions FundTransaction[]

  @@map("funds")
}

model FundTransaction {
  id          Int      @id @default(autoincrement())
  fundId      Int
  amount      Int
  type        String
  description String?
  date        DateTime
  createdAt   DateTime @default(now())
  fund        Fund     @relation(fields: [fundId], references: [id])

  @@map("fund_transactions")
}

model ProjectReport {
  id         Int      @id @default(autoincrement())
  projectId  Int
  date       DateTime
  periodFrom DateTime
  periodTo   DateTime
  comment    String?
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id])

  @@map("project_reports")
}

model ShopReport {
  id          Int              @id @default(autoincrement())
  employeeId  Int
  projectId   Int?
  date        DateTime
  periodFrom  DateTime
  periodTo    DateTime
  comment     String?
  totalAmount Float            @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  eotItems    EOTReportItem[]
  items       ShopReportItem[]
  project     Project?         @relation(fields: [projectId], references: [id])
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("shop_reports")
}

model ShopReportItem {
  id         Int           @id @default(autoincrement())
  reportId   Int
  workTypeId Int?
  workName   String
  quantity   Float
  rate       Float
  amount     Float
  createdAt  DateTime      @default(now())
  workType   WorkTemplate? @relation(fields: [workTypeId], references: [id])
  report     ShopReport    @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("shop_report_items")
}

model EmployeeWorkReport {
  id         Int      @id @default(autoincrement())
  employeeId Int
  projectId  Int?
  workType   String
  quantity   Float
  rate       Float
  amount     Float
  date       DateTime
  comment    String?
  stage      String?
  createdAt  DateTime @default(now())
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_work_reports")
}

model FinanceReport {
  id           Int      @id @default(autoincrement())
  projectId    Int?
  date         DateTime
  totalIncome  Int
  totalExpense Int
  profit       Int
  comment      String?
  createdAt    DateTime @default(now())
  project      Project? @relation(fields: [projectId], references: [id])

  @@map("finance_reports")
}

model ProjectTransaction {
  id        Int      @id @default(autoincrement())
  projectId Int
  amount    Int
  date      DateTime
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id])

  @@index([date])
  @@index([projectId, date])
  @@map("project_transactions")
}

model Notification {
  id         Int            @id @default(autoincrement())
  type       String
  message    String
  priority   String
  link       String?
  date       DateTime
  isRead     Boolean        @default(false)
  isArchived Boolean        @default(false)
  projectId  Int?
  itemId     Int?
  createdAt  DateTime       @default(now())
  item       WarehouseItem? @relation(fields: [itemId], references: [id])

  @@map("notifications")
}

model FinancialPlan {
  id              Int      @id @default(autoincrement())
  projectId       Int
  periodFrom      DateTime
  periodTo        DateTime
  plannedAmount   Int
  comment         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  project         Project  @relation(fields: [projectId], references: [id])

  @@index([periodFrom, periodTo])
  @@index([projectId])
  @@map("financial_plans")
}

model Expense {
  id              Int              @id @default(autoincrement())
  date            DateTime
  amount          Int
  recipient       String
  purpose         String
  categoryId      Int?
  category        String
  supplierId      Int?
  projectId       Int?
  createdAt       DateTime         @default(now())
  supplier        Supplier?        @relation(fields: [supplierId], references: [id])
  expenseCategory ExpenseCategory? @relation(fields: [categoryId], references: [id])
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([projectId])
  @@map("expenses")
}

model AdvanceReport {
  id          Int                 @id @default(autoincrement())
  date        DateTime
  totalAmount Int
  createdAt   DateTime            @default(now())
  items       AdvanceReportItem[]

  @@index([date])
  @@map("advance_reports")
}

model AdvanceReportItem {
  id           Int           @id @default(autoincrement())
  reportId     Int
  employeeId   Int
  employeeName String
  amount       Int
  purpose      String
  date         DateTime      @default(now())
  report       AdvanceReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("advance_report_items")
}

model EOTReport {
  id          Int             @id @default(autoincrement())
  date        DateTime
  totalAmount Float           @default(0)
  status      String          @default("pending")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       EOTReportItem[]

  @@index([date])
  @@map("eot_reports")
}

model EOTReportItem {
  id           Int         @id @default(autoincrement())
  reportId     Int
  employeeId   Int
  employeeName String
  paymentType  String
  hours        Float?
  rate         Float?
  quantity     Float?
  workAmount   Float?
  salary       Float
  shopReportId Int?
  comment      String?
  shopReport   ShopReport? @relation(fields: [shopReportId], references: [id])
  report       EOTReport   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("eot_report_items")
}

model Penalty {
  id         Int      @id @default(autoincrement())
  employeeId Int
  amount     Int
  date       DateTime
  reason     String
  createdAt  DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("penalties")
}

model Bonus {
  id         Int      @id @default(autoincrement())
  employeeId Int
  amount     Int
  date       DateTime
  reason     String
  createdAt  DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("bonuses")
}

model SalaryReport {
  id          Int                @id @default(autoincrement())
  date        DateTime
  period      String
  totalAmount Int
  status      String             @default("pending")
  createdAt   DateTime           @default(now())
  items       SalaryReportItem[]

  @@index([date])
  @@map("salary_reports")
}

model SalaryReportItem {
  id           Int          @id @default(autoincrement())
  reportId     Int
  employeeId   Int
  employeeName String
  amount       Int
  period       String
  grossSalary  Int?
  advances     Int?
  penalties    Int?
  days         Int?
  isPaid       Boolean      @default(false)
  hours        Float?
  shifts       Int?
  bonuses      Int?
  report       SalaryReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("salary_report_items")
}

model HourlyRate {
  id        Int        @id @default(autoincrement())
  position  String
  rate      Int
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  employees Employee[]

  @@map("hourly_rates")
}

model Subcontractor {
  id             Int       @id @default(autoincrement())
  companyName    String
  contactPerson  String
  phone          String
  email          String?
  address        String
  specialization String
  status         String    @default("active")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  projects       Project[] @relation("ProjectToSubcontractor")

  @@map("subcontractors")
}

model TechEquipment {
  id              Int       @id @default(autoincrement())
  name            String
  type            String
  inventoryNumber String    @unique
  status          String    @default("warehouse")
  location        String
  acquisitionDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("tech_equipment")
}

model Supplier {
  id             Int                 @id @default(autoincrement())
  companyName    String
  contactPerson  String
  phone          String
  email          String?
  address        String
  category       String
  status         String              @default("active")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  expenses       Expense[]
  warehouseItems WarehouseItem[]
  movements      WarehouseMovement[]

  @@map("suppliers")
}

model Schedule {
  id         Int      @id @default(autoincrement())
  date       DateTime
  employeeId Int
  projectId  Int?
  brigadeId  Int?
  workType   String?
  hours      Float
  status     String   @default("план")
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  brigade    Brigade? @relation(fields: [brigadeId], references: [id])
  project    Project? @relation(fields: [projectId], references: [id])
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([employeeId])
  @@index([projectId])
  @@map("schedules")
}

model SummaryReport {
  id           Int      @id @default(autoincrement())
  name         String
  period       String
  date         DateTime
  periodFrom   DateTime
  periodTo     DateTime
  totalIncome  Float
  totalExpense Float
  profit       Float
  data         String
  createdAt    DateTime @default(now())

  @@map("summary_reports")
}

model Document {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String
  fileName    String
  mimeType    String?
  fileSize    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("documents")
}

model Skill {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  brigades    Brigade[]  @relation("BrigadeSkills")
  employees   Employee[] @relation("EmployeeSkills")

  @@map("skills")
}

model ExpenseCategory {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expenses  Expense[]

  @@map("expense_categories")
}

model EmployeeAdvance {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  employeeName String
  amount      Int
  date        DateTime
  purpose     String?
  status      String   @default("active") // active, settled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId])
  @@index([date])
  @@map("employee_advances")
}
